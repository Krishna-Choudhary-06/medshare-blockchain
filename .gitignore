# Node modules - never share these
node_modules/
npm-debug.log

# Environment files - contains secrets
.env
*.env

# Fabric generated files
organizations/
channel-artifacts/
system-genesis-block/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Keys and certificates - security sensitive
*.pem
*.key
*.crt
app/wallet/
app/data/
frontend/dist/
# Fabric crypto material generated by cryptogen - contains private keys, never commit
network/fabric/crypto-config/
network/fabric/fabric-samples/
*_sk

# Fabric network working artifacts (regenerated by start-fabric.sh / setup-channel.sh)
network/fabric/core.yaml
network/fabric/peercfg/
network/fabric/connection.json
network/fabric/metadata.json
network/fabric/*.tar.gz
network/fabric/*.bak
